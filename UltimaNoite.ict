    behaviors: []
    extendTypes: ''
  - type: template
    baseClass: AnimatedSprite
    name: Zumbi
    depth: 0
    texture: g4J3wD789fdHjC
    playAnimationOnStart: false
    loopAnimation: true
    animationFPS: 30
    visible: true
    events:
      - eventKey: OnStep
        lib: core
        code: |

          /* ==========================================
             ULTIMA NOITE - ZUMBI
             EVENTO: NO INICIO DO QUADRO

             PERSEGUICAO
             SEPARACAO
             ATAQUE
             ROTACAO
          ========================================== */

          // ===== BUSCAR JOGADOR =====

          const jogadores = templates.list['Jogador'] || [];

          const jogador = jogadores.find(
              j => templates.valid(j)
          );

          // ===== BUSCAR OUTROS ZUMBIS =====

          const zumbis = (
              templates.list['Zumbi'] || []
          ).filter(
              z => templates.valid(z) &&
                   !z.kill &&
                   z.vida > 0
          );

          // ===== MOVIMENTACAO =====

          let moverX = 0;
          let moverY = 0;

          if (
              jogador &&
              jogador.vida > 0 &&
              this.vida > 0
          ) {

              // ===== DIRECAO DO JOGADOR =====

              const dx = jogador.x - this.x;
              const dy = jogador.y - this.y;

              const distancia = Math.hypot(dx, dy);

              // ===== ROTACAO DO ZUMBI =====

              const angulo = u.pointDirection(
                  this.x,
                  this.y,
                  jogador.x,
                  jogador.y
              );

              // A sprite original olha para baixo
              this.angle = angulo - 90;

              // ===== PERSEGUICAO =====

              if (distancia > 20) {
                  moverX = dx / distancia;
                  moverY = dy / distancia;
              }

              // ===== SEPARACAO ENTRE ZUMBIS =====

              let separarX = 0;
              let separarY = 0;

              for (const outro of zumbis) {

                  if (outro === this) {
                      continue;
                  }

                  const ox = this.x - outro.x;
                  const oy = this.y - outro.y;

                  const d = Math.hypot(ox, oy);

                  if (
                      d > 0 &&
                      d < this.raioDeteccao
                  ) {

                      const intensidade =
                          (this.raioDeteccao - d) /
                          this.raioDeteccao;

                      separarX +=
                          (ox / d) * intensidade;

                      separarY +=
                          (oy / d) * intensidade;
                  }
              }

              // ===== COMBINAR MOVIMENTOS =====

              moverX +=
                  separarX * this.forcaSeparacao;

              moverY +=
                  separarY * this.forcaSeparacao;

              const tamanho = Math.hypot(
                  moverX,
                  moverY
              );

              if (tamanho > 0) {

                  this.hspeed =
                      (moverX / tamanho) *
                      this.velocidade;

                  this.vspeed =
                      (moverY / tamanho) *
                      this.velocidade;

              } else {

                  this.hspeed = 0;
                  this.vspeed = 0;
              }

              // ===== APLICAR MOVIMENTO =====

              this.move();

              // ===== CORRIGIR SOBREPOSICOES =====

              const minimo = this.distanciaSeparacao;

              for (let passo = 0; passo < 2; passo++) {

                  for (const outro of zumbis) {

                      if (outro === this) {
                          continue;
                      }

                      let ox = this.x - outro.x;
                      let oy = this.y - outro.y;

                      let d = Math.hypot(ox, oy);

                      if (d >= minimo) {
                          continue;
                      }

                      if (d < 0.001) {

                          const indice =
                              zumbis.indexOf(this);

                          const indiceOutro =
                              zumbis.indexOf(outro);

                          ox = indice > indiceOutro
                              ? 1
                              : -1;

                          oy = 0;
                          d = 1;
                      }

                      const sobreposicao =
                          minimo - d;

                      this.x +=
                          (ox / d) * sobreposicao;

                      this.y +=
                          (oy / d) * sobreposicao;
                  }
              }

              // ===== LIMITES DA ARENA =====

              this.x = Math.max(
                  26,
                  Math.min(1254, this.x)
              );

              this.y = Math.max(
                  26,
                  Math.min(694, this.y)
              );

              // ===== ATAQUE AO JOGADOR =====

              const colisao = place.meet(
                  this,
                  'Jogador'
              );

              if (colisao) {

                  const agora = Date.now();

                  if (
                      agora - this.ultimoAtaque >=
                      this.intervaloAtaque
                  ) {

                      jogador.vida = Math.max(
                          0,
                          jogador.vida - this.dano
                      );

                      this.ultimoAtaque = agora;

                      console.log(
                          'Jogador atingido! Vida:',
                          jogador.vida
                      );

                      if (jogador.vida <= 0) {
                          console.log('GAME OVER!');
                      }
                  }
              }

          } else {

              this.hspeed = 0;
              this.vspeed = 0;
          }
        arguments: {}
      - eventKey: OnCreate
        code: |

          /* ==========================================
             ULTIMA NOITE - ZUMBI
             EVENTO: CRIACAO
          ========================================== */

          // ===== ATRIBUTOS =====

          this.vida = 40;
          this.vidaMaxima = 40;

          this.velocidade = 90;
          this.dano = 10;

          this.pontosAoMorrer = 100;

          // ===== MOVIMENTACAO =====

          this.hspeed = 0;
          this.vspeed = 0;

          // ===== ATAQUE =====

          this.ultimoAtaque = 0;
          this.intervaloAtaque = 1000;

          // ===== SEPARACAO ENTRE ZUMBIS =====

          // Distancia minima entre centros
          this.distanciaSeparacao = 35;

          // Forca de separacao
          this.forcaSeparacao = 2.5;

          // Raio de deteccao dos outros zumbis
          this.raioDeteccao = 55;

          // ===== VISUAL REALISTA =====

          // Escala do zumbi
          this.scale.set(0.08);

          // ===== ANIMACAO =====

          // Velocidade da animacao
          this.animationSpeed = 0.09;

          // Repeticao dos quadros
          this.loop = true;

          // Inicia a caminhada
          this.gotoAndPlay(0);

          // ===== ROTACAO =====

          this.angle = 0;
        arguments: {}
        lib: core
    extends:
      cgroup: ''
      'editor:myCollidingCGroups': []
    lastmod: 1794486805237
