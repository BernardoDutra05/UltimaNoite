  - type: template
    baseClass: Text
    name: TelaGameOver
    depth: 0
    texture: -1
    playAnimationOnStart: false
    loopAnimation: true
    animationFPS: 30
    visible: true
    events:
      - eventKey: OnCreate
        code: |

          /* ==========================================
             ULTIMA NOITE - TELA GAME OVER
             EVENTO: CRIACAO
          ========================================== */

          this.text = '';

          // Dados recebidos da partida
          const resultado = ct.ultimaNoiteResultado || {
              pontos: 0,
              onda: 0,
              recorde: 0
          };

          // ===== FUNCAO PARA CRIAR TEXTOS =====

          const criarTexto = (conteudo, tamanho, cor, x, y) => {
              const texto = new PIXI.Text(conteudo, {
                  fontFamily: 'Arial',
                  fontSize: tamanho,
                  fontWeight: 'bold',
                  fill: cor,
                  align: 'center'
              });

              texto.anchor.set(0.5);
              texto.x = x;
              texto.y = y;

              this.addChild(texto);
              return texto;
          };

          // ===== PAINEL CENTRAL =====

          const painel = new PIXI.Graphics();

          painel.beginFill(0x273142);
          painel.lineStyle(2, 0x56627A);
          painel.drawRoundedRect(
              340, 100, 600, 520, 18
          );
          painel.endFill();

          this.addChild(painel);

          // ===== TITULO =====

          criarTexto(
              'GAME OVER',
              56,
              0xF87171,
              640, 175
          );

          criarTexto(
              'A NOITE VENCEU DESTA VEZ...',
              20,
              0xCBD5E1,
              640, 230
          );

          // ===== RESULTADOS =====

          criarTexto(
              'PONTUACAO: ' + resultado.pontos,
              28,
              0xFFFFFF,
              640, 305
          );

          criarTexto(
              'RECORDE: ' + resultado.recorde,
              26,
              0xFACC15,
              640, 355
          );

          criarTexto(
              'ONDA ALCANCADA: ' + resultado.onda,
              22,
              0xCBD5E1,
              640, 405
          );

          // ===== FUNCAO PARA CRIAR BOTOES =====

          const criarBotao = (nome, y, acao) => {

              const botao = new PIXI.Container();

              botao.x = 460;
              botao.y = y;

              const fundo = new PIXI.Graphics();

              fundo.beginFill(0x315F83);
              fundo.drawRoundedRect(
                  0, 0, 360, 54, 9
              );
              fundo.endFill();

              botao.addChild(fundo);

              const texto = new PIXI.Text(nome, {
                  fontFamily: 'Arial',
                  fontSize: 20,
                  fontWeight: 'bold',
                  fill: 0xFFFFFF
              });

              texto.anchor.set(0.5);
              texto.x = 180;
              texto.y = 27;

              botao.addChild(texto);

              // Interacao com o mouse
              botao.eventMode = 'static';
              botao.cursor = 'pointer';

              botao.hitArea = new PIXI.Rectangle(
                  0, 0, 360, 54
              );

              botao.on('pointertap', acao);

              this.addChild(botao);

              return botao;
          };

          // ===== BOTOES =====

          criarBotao(
              'JOGAR NOVAMENTE',
              465,
              () => rooms.switch('rm_jogo')
          );

          criarBotao(
              'MENU PRINCIPAL',
              535,
              () => rooms.switch('rm_menu')
          );
        arguments: {}
        lib: core
    extends:
      cgroup: ''
      'editor:myCollidingCGroups': []
