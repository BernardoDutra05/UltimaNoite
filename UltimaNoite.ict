  - type: template
    baseClass: AnimatedSprite
    name: Projetil
    depth: 0
    texture: 3CnmjDpf4k3Pw3
    playAnimationOnStart: false
    loopAnimation: true
    animationFPS: 30
    visible: true
    events:
      - eventKey: OnStep
        lib: core
        code: |

          /* ===== MOVIMENTAÇÃO ===== */

          this.angle = this.direction;
          this.move();

          /* ===== COLISÃO COM ZUMBI ===== */

          const zumbi = place.meet(this, 'Zumbi');

          if (
              zumbi &&
              templates.valid(zumbi) &&
              !zumbi.kill &&
              zumbi.vida > 0
          ) {
              // Aplica dano
              zumbi.vida -= this.dano;

              console.log(
                  'Zumbi atingido! Vida:',
                  zumbi.vida
              );

              /* ===== MORTE DO ZUMBI ===== */

              if (zumbi.vida <= 0) {

                  // Bloqueia novas mortes
                  zumbi.kill = true;

          // Sorteia entre 1 e 3 moedas
          const quantidadeMoedas =
              Math.floor(Math.random() * 3) + 1;

          for (let i = 0; i < quantidadeMoedas; i++) {

              // Espalha as moedas perto do zumbi
              const angulo = Math.random() * Math.PI * 2;
              const distancia = 35 + Math.random() * 35;

              const x = Math.max(
                  16,
                  Math.min(
                      1264,
                      zumbi.x + Math.cos(angulo) * distancia
                  )
              );

              const y = Math.max(
                  16,
                  Math.min(
                      704,
                      zumbi.y + Math.sin(angulo) * distancia
                  )
              );

              templates.copy('Moeda', x, y);
          }

          console.log(
              'Zumbi deixou',
              quantidadeMoedas,
              'moedas!'
          );

                  // Adiciona pontuação ao jogador
                  const jogadores =
                      templates.list['Jogador'] || [];

                  const jogador = jogadores.find(
                      j => templates.valid(j)
                  );

                  if (jogador) {
                      jogador.pontos +=
                          zumbi.pontosAoMorrer;
                  }

                  /* ===== DROP DE KIT MÉDICO ===== */

                  // 7% de chance
                  const chance = Math.random();

                  if (chance < 0.07) {

                      templates.copy(
                          'KitMedico',
                          zumbi.x,
                          zumbi.y
                      );

                      console.log(
                          'Kit médico apareceu!'
                      );
                  }
              }

              // Remove a bala depois do impacto
              this.kill = true;

          } else if (
              this.x < -40 ||
              this.x > 1320 ||
              this.y < -40 ||
              this.y > 760
          ) {
              // Remove tiros fora da arena
              this.kill = true;
          }
        arguments: {}
      - eventKey: OnCreate
        code: |

          this.speed = 500;
          this.dano = 20;
        arguments: {}
        lib: core
    extends:
      cgroup: ''
      'editor:myCollidingCGroups': []
