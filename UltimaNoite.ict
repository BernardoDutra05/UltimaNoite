  - type: template
    baseClass: AnimatedSprite
    name: Jogador
    depth: 0
    texture: k9QwL7rngqPDhk
    playAnimationOnStart: false
    loopAnimation: true
    animationFPS: 30
    visible: true
    events:
      - eventKey: OnStep
        lib: core
        code: |+

          /* ===== MOVIMENTAÇÃO ===== */

          const dx = actions.MoveXesq.value +
                     actions.MoveXdir.value;

          const dy = actions.MoveYcima.value +
                     actions.MoveYbaixo.value;

          const distancia = Math.hypot(dx, dy);

          if (distancia > 0) {
              this.hspeed = (dx / distancia) * this.velocidade;
              this.vspeed = (dy / distancia) * this.velocidade;
          } else {
              this.hspeed = 0;
              this.vspeed = 0;
          }

          this.move();

          // Limites da arena
          this.x = Math.max(16, Math.min(1264, this.x));
          this.y = Math.max(16, Math.min(704, this.y));


          /* ===== MIRA COM O MOUSE ===== */

          // Calcula o ângulo até o cursor
          const angulo = u.pointDirection(
              this.x,
              this.y,
              pointer.x,
              pointer.y
          );

          // Rotaciona visualmente o jogador
          // A textura original aponta para cima
          this.angle = angulo + 90;


          /* ===== DISPARO ===== */


          if (actions.Atirar.pressed) {

              const tiro = templates.copy(
                  'Projetil',
                  this.x,
                  this.y
              );

              tiro.dano = this.dano;
              tiro.speed = this.velocidadeProjetil;
              tiro.direction = angulo;
              tiro.angle = angulo;
          }

        arguments: {}
      - eventKey: OnCreate
        code: |-
          //Atributos Iniciais
          this.vida = 100;
          this.vidaMaxima = 100;
          this.velocidade = 240;
          this.dano = 20;
          this.moedas = 0;
          this.pontos = 0;
          this.velocidadeProjetil = 500;
        arguments: {}
        lib: core
    extends:
      cgroup: ''
      'editor:myCollidingCGroups': []
    lastmod: 1794423860845
    uid: 489p9JKMb6NGWT
    behaviors: []
    extendTypes: ''
  - type: template
    baseClass: AnimatedSprite
    name: Zumbi
    depth: 0
    texture: 9BrRzpMzmwL4Gq
    playAnimationOnStart: false
    loopAnimation: true
    animationFPS: 30
    visible: true
    events:
      - eventKey: OnStep
        lib: core
        code: |

          /* =========================================
             ULTIMA NOITE - ZUMBI
             EVENTO: NO INICIO DO QUADRO
          ========================================= */

          // ===== BUSCAR JOGADOR =====

          const jogadores = templates.list['Jogador'] || [];

          const jogador = jogadores.find(
              j => templates.valid(j)
          );

          // ===== PERSEGUIR JOGADOR =====

          if (jogador && jogador.vida > 0) {

              const dx = jogador.x - this.x;
              const dy = jogador.y - this.y;

              const distancia = Math.hypot(dx, dy);

              if (distancia > 20) {

                  this.hspeed =
                      (dx / distancia) * this.velocidade;

                  this.vspeed =
                      (dy / distancia) * this.velocidade;

              } else {

                  this.hspeed = 0;
                  this.vspeed = 0;
              }

              // Movimenta o inimigo
              this.move();

              // ===== ATAQUE =====

              const colisao = place.meet(
                  this,
                  'Jogador'
              );

              if (colisao) {

                  const agora = Date.now();

                  if (
                      agora - this.ultimoAtaque >=
                      this.intervaloAtaque
                  ) {

                      jogador.vida = Math.max(
                          0,
                          jogador.vida - this.dano
                      );

                      this.ultimoAtaque = agora;

                      console.log(
                          'Jogador atingido! Vida:',
                          jogador.vida
                      );
                  }
              }

          } else {

              this.hspeed = 0;
              this.vspeed = 0;
          }

          // ===== BARRA DE VIDA =====

          if (
              this.ultimaVidaDesenhada !== this.vida ||
              this.ultimaVidaMaximaDesenhada !==
              this.vidaMaxima
          ) {

              this.ultimaVidaDesenhada = this.vida;
              this.ultimaVidaMaximaDesenhada =
                  this.vidaMaxima;

              const percentual = Math.max(
                  0,
                  Math.min(
                      1,
                      this.vida / this.vidaMaxima
                  )
              );

              this.barraVida.clear();

              // Fundo da barra
              this.barraVida.beginFill(0x542B35);

              this.barraVida.drawRoundedRect(
                  -20, 0, 40, 6, 2
              );

              this.barraVida.endFill();

              // Preenchimento da barra
              if (percentual > 0) {

                  const cor = percentual <= 0.30
                      ? 0xEF5365
                      : 0x77C66E;

                  this.barraVida.beginFill(cor);

                  this.barraVida.drawRoundedRect(
                      -20,
                      0,
                      40 * percentual,
                      6,
                      2
                  );

                  this.barraVida.endFill();
              }
          }
        arguments: {}
      - eventKey: OnCreate
        code: |

          /* =========================================
             ULTIMA NOITE - ZUMBI
             EVENTO: CRIACAO
          ========================================= */

          // Atributos iniciais
          this.vida = 40;
          this.vidaMaxima = 40;
          this.velocidade = 90;
          this.dano = 10;
          this.pontosAoMorrer = 100;

          // Movimento
          this.hspeed = 0;
          this.vspeed = 0;

          // Ataque
          this.ultimoAtaque = 0;
          this.intervaloAtaque = 1000;

          // ===== BARRA DE VIDA =====

          this.barraVida = new PIXI.Graphics();

          // Posicao relativa ao zumbi
          this.barraVida.x = 0;
          this.barraVida.y = -25;

          // Adiciona a barra ao objeto
          this.addChild(this.barraVida);

          // Controle para evitar redesenhos
          this.ultimaVidaDesenhada = -1;
          this.ultimaVidaMaximaDesenhada = -1;
        arguments: {}
        lib: core
    extends:
      cgroup: ''
      'editor:myCollidingCGroups': []
    lastmod: 1794425669402
    uid: Wc8qB488wMpN3Q
    behaviors: []
    extendTypes: ''
  - type: template
    baseClass: AnimatedSprite
    name: Projetil
    depth: 0
    texture: 3CnmjDpf4k3Pw3
    playAnimationOnStart: false
    loopAnimation: true
    animationFPS: 30
    visible: true
    events:
      - eventKey: OnStep
        lib: core
        code: |

          /* ===== MOVIMENTAÇÃO ===== */

          this.angle = this.direction;
          this.move();

          /* ===== COLISÃO COM ZUMBI ===== */

          const zumbi = place.meet(this, 'Zumbi');

          if (
              zumbi &&
              templates.valid(zumbi) &&
              !zumbi.kill &&
              zumbi.vida > 0
          ) {
              // Aplica dano
              zumbi.vida -= this.dano;

              console.log(
                  'Zumbi atingido! Vida:',
                  zumbi.vida
              );

              /* ===== MORTE DO ZUMBI ===== */

              if (zumbi.vida <= 0) {

                  // Bloqueia novas mortes
                  zumbi.kill = true;

          // Sorteia entre 1 e 3 moedas
          const quantidadeMoedas =
              Math.floor(Math.random() * 3) + 1;

          for (let i = 0; i < quantidadeMoedas; i++) {

              // Espalha as moedas perto do zumbi
              const angulo = Math.random() * Math.PI * 2;
              const distancia = 35 + Math.random() * 35;

              const x = Math.max(
                  16,
                  Math.min(
                      1264,
                      zumbi.x + Math.cos(angulo) * distancia
                  )
              );

              const y = Math.max(
                  16,
                  Math.min(
                      704,
                      zumbi.y + Math.sin(angulo) * distancia
                  )
              );

              templates.copy('Moeda', x, y);
          }

          console.log(
              'Zumbi deixou',
              quantidadeMoedas,
              'moedas!'
          );

                  // Adiciona pontuação ao jogador
                  const jogadores =
                      templates.list['Jogador'] || [];

                  const jogador = jogadores.find(
                      j => templates.valid(j)
                  );

                  if (jogador) {
                      jogador.pontos +=
                          zumbi.pontosAoMorrer;
                  }

                  /* ===== DROP DE KIT MÉDICO ===== */

                  // 7% de chance
                  const chance = Math.random();

                  if (chance < 0.07) {

                      templates.copy(
                          'KitMedico',
                          zumbi.x,
                          zumbi.y
                      );

                      console.log(
                          'Kit médico apareceu!'
                      );
                  }
              }

              // Remove a bala depois do impacto
              this.kill = true;

          } else if (
              this.x < -40 ||
              this.x > 1320 ||
              this.y < -40 ||
              this.y > 760
          ) {
              // Remove tiros fora da arena
              this.kill = true;
          }
        arguments: {}
      - eventKey: OnCreate
        code: |

          this.speed = 500;
          this.dano = 20;
        arguments: {}
        lib: core
    extends:
      cgroup: ''
      'editor:myCollidingCGroups': []
