  - type: template
    baseClass: Text
    name: Hud
    depth: 0
    texture: -1
    playAnimationOnStart: false
    loopAnimation: true
    animationFPS: 30
    visible: true
    events:
      - eventKey: OnStep
        lib: core
        code: |

          // A HUD e atualizada no evento
          // No final do quadro.
        arguments: {}
      - eventKey: OnDraw
        code: |

          /* ==========================================
             ULTIMA NOITE - HUD
             EVENTO: NO FINAL DO QUADRO
          ========================================== */

          // ==========================================
          // 1. BUSCAR JOGADOR
          // ==========================================

          const jogadores = templates.list['Jogador'] || [];

          const jogador = jogadores.find(
              j => templates.valid(j)
          );

          if (!jogador) {

              this.textoVida.text = '';
              this.textoInfo.text = '';

              this.graficosVida.clear();
              this.barrasZumbis.clear();

              this.lojaContainer.visible = false;

              return;
          }

          // ==========================================
          // 2. BUSCAR GERENCIADOR DE ONDAS
          // ==========================================

          const gerenciadores =
              templates.list['GerenciadorOndas'] || [];

          const gerenciador = gerenciadores.find(
              g => templates.valid(g)
          );

          // ==========================================
          // 3. VERIFICAR GAME OVER
          // ==========================================

          if (
              jogador.vida <= 0 &&
              !jogador.gameOverRegistrado
          ) {

              jogador.gameOverRegistrado = true;

              const pontos = jogador.pontos;

              const onda = gerenciador
                  ? gerenciador.onda
                  : 0;

              let recorde = 0;

              try {

                  recorde = Number(
                      localStorage.getItem(
                          'UltimaNoite_recorde'
                      ) || 0
                  );

                  if (pontos > recorde) {

                      recorde = pontos;

                      localStorage.setItem(
                          'UltimaNoite_recorde',
                          String(recorde)
                      );
                  }

              } catch (erro) {

                  recorde = Math.max(
                      recorde,
                      pontos
                  );

                  console.warn(
                      'Nao foi possivel salvar o recorde',
                      erro
                  );
              }

              ct.ultimaNoiteResultado = {
                  pontos: pontos,
                  onda: onda,
                  recorde: recorde
              };

              console.log(
                  'GAME OVER!',
                  ct.ultimaNoiteResultado
              );

              rooms.switch('rm_gameover');

              return;
          }

          // ==========================================
          // 4. CONTAR ZUMBIS
          // ==========================================

          const zumbis = templates.list['Zumbi'] || [];

          const zumbisVivos = zumbis.filter(
              z => templates.valid(z) &&
                   !z.kill &&
                   z.vida > 0
          );

          const inimigos = zumbisVivos.length;

          // ==========================================
          // 5. ATRIBUTOS DO JOGADOR
          // ==========================================

          const vida = Math.max(
              0,
              Math.ceil(jogador.vida)
          );

          const vidaMaxima = Math.max(
              1,
              jogador.vidaMaxima
          );

          const percentualVida = Math.max(
              0,
              Math.min(
                  1,
                  vida / vidaMaxima
              )
          );

          const ondaAtual = gerenciador
              ? gerenciador.onda
              : 0;

          // ==========================================
          // 6. BARRA DE VIDA DO JOGADOR
          // ==========================================

          this.textoVida.text =
              'VIDA: ' + vida +
              '/' + vidaMaxima;

          this.graficosVida.clear();

          // Fundo da barra
          this.graficosVida.beginFill(0x542B35);

          this.graficosVida.drawRoundedRect(
              5,
              34,
              250,
              18,
              6
          );

          this.graficosVida.endFill();

          // Vida atual
          if (percentualVida > 0) {

              const cor = percentualVida <= 0.30
                  ? 0xF59E42
                  : 0xEF5365;

              this.graficosVida.beginFill(cor);

              this.graficosVida.drawRoundedRect(
                  5,
                  34,
                  250 * percentualVida,
                  18,
                  6
              );

              this.graficosVida.endFill();
          }

          // ==========================================
          // 7. INFORMACOES DA PARTIDA
          // ==========================================

          this.textoInfo.text =
              'PONTOS: ' + jogador.pontos +
              '\nMOEDAS: ' + jogador.moedas +
              '\nONDA: ' + ondaAtual +
              '\nINIMIGOS: ' + inimigos;

          // ==========================================
          // 8. BARRAS DE VIDA DOS ZUMBIS
          // ==========================================

          this.barrasZumbis.clear();

          for (const zumbi of zumbisVivos) {

              // Evita divisao por zero
              const vidaMaxZumbi = Math.max(
                  1,
                  zumbi.vidaMaxima
              );

              const percentual = Math.max(
                  0,
                  Math.min(
                      1,
                      zumbi.vida / vidaMaxZumbi
                  )
              );

              // Coordenadas relativas a HUD
              const x = zumbi.x - this.x;

              const y =
                  zumbi.y -
                  this.y -
                  this.deslocamentoBarraZumbi;

              const largura = this.larguraBarraZumbi;

              const altura = this.alturaBarraZumbi;

              // ===== COR DA BARRA =====

              let cor = 0x72D46D;

              if (percentual <= 0.30) {

                  cor = 0xEF5961;

              } else if (percentual <= 0.60) {

                  cor = 0xEFBB4E;
              }

              // ===== FUNDO DA BARRA =====

              this.barrasZumbis.beginFill(
                  0x512B34
              );

              this.barrasZumbis.drawRoundedRect(
                  x - largura / 2,
                  y,
                  largura,
                  altura,
                  3
              );

              this.barrasZumbis.endFill();

              // ===== VIDA RESTANTE =====

              if (percentual > 0) {

                  this.barrasZumbis.beginFill(cor);

                  this.barrasZumbis.drawRoundedRect(
                      x - largura / 2,
                      y,
                      largura * percentual,
                      altura,
                      3
                  );

                  this.barrasZumbis.endFill();
              }
          }

          // ==========================================
          // 9. VERIFICAR LOJA
          // ==========================================

          const lojaAberta = Boolean(
              gerenciador &&
              gerenciador.estado === 'escolha'
          );

          this.lojaContainer.visible = lojaAberta;

          // ==========================================
          // 10. DESENHAR LOJA
          // ==========================================

          if (lojaAberta) {

              // ===== FUNDO ESCURO =====

              this.fundoLoja.clear();

              this.fundoLoja.beginFill(
                  0x080D17,
                  0.90
              );

              this.fundoLoja.drawRect(
                  -25,
                  -25,
                  1280,
                  720
              );

              this.fundoLoja.endFill();

              // ===== TITULO =====

              this.tituloLoja.text =
                  'ONDA ' + ondaAtual +
                  ' CONCLUIDA!\nLOJA DE MELHORIAS';

              // ===== SALDO =====

              this.saldoLoja.text =
                  'SALDO: ' +
                  jogador.moedas +
                  ' MOEDAS';

              // ===== CARDS =====

              this.graficosLoja.clear();

              const opcoes =
                  gerenciador.opcoesMelhoria || [];

              for (let i = 0; i < 3; i++) {

                  const melhoria = opcoes[i];

                  if (!melhoria) {

                      this.cardsLoja[i].text = '';
                      continue;
                  }

                  const x = 235 + i * 260;
                  const y = 270;

                  const podeComprar =
                      jogador.moedas >= melhoria.preco;

                  const corFundo = podeComprar
                      ? 0x293143
                      : 0x353039;

                  const corBorda = podeComprar
                      ? 0xE6BE64
                      : 0x76505A;

                  // ===== FUNDO DO CARD =====

                  this.graficosLoja.beginFill(
                      corFundo
                  );

                  this.graficosLoja.drawRoundedRect(
                      x,
                      y,
                      240,
                      180,
                      12
                  );

                  this.graficosLoja.endFill();

                  // ===== BORDA =====

                  this.graficosLoja.lineStyle(
                      2,
                      corBorda
                  );

                  this.graficosLoja.drawRoundedRect(
                      x,
                      y,
                      240,
                      180,
                      12
                  );

                  this.graficosLoja.lineStyle(0);

                  // ===== DISPONIBILIDADE =====

                  const status = podeComprar
                      ? 'DISPONIVEL'
                      : 'SEM MOEDAS';

                  // ===== TEXTO =====

                  this.cardsLoja[i].text =
                      '[' + (i + 1) + ']' +
                      '\n\n' +
                      melhoria.nome +
                      '\n\n' +
                      melhoria.preco + ' MOEDAS' +
                      '\n' +
                      status;
              }

              // ===== INSTRUCOES =====

              this.instrucaoLoja.text =
                  'PRESSIONE 1, 2 OU 3 PARA COMPRAR' +
                  '\nPRESSIONE 0 PARA PULAR';
          }
        arguments: {}
        lib: core
      - eventKey: OnCreate
        code: |

          /* ==========================================
             ULTIMA NOITE - HUD
             EVENTO: CRIACAO
          ========================================== */

          this.text = '';

          // ===== FUNCAO PARA CRIAR TEXTOS =====

          this.criarTexto = (
              tamanho,
              cor,
              alinhamento = 'left'
          ) => {

              const estilo = new PIXI.TextStyle({
                  fontFamily: 'Arial',
                  fontSize: tamanho,
                  fontWeight: 'bold',
                  fill: cor
              });

              estilo.align = alinhamento;

              const texto = new PIXI.Text('', estilo);

              this.addChild(texto);

              return texto;
          };

          // ==========================================
          // BARRA DE VIDA DO JOGADOR
          // ==========================================

          this.graficosVida = new PIXI.Graphics();

          this.addChild(this.graficosVida);

          this.textoVida = this.criarTexto(
              22,
              0xFFFFFF
          );

          this.textoVida.x = 5;
          this.textoVida.y = 0;

          // ==========================================
          // INFORMACOES DA PARTIDA
          // ==========================================

          this.textoInfo = this.criarTexto(
              20,
              0xFFFFFF,
              'right'
          );

          // Ancora o texto pelo lado direito
          this.textoInfo.anchor.set(1, 0);

          // Mantem o texto dentro da arena

          /* ===== POSICIONAMENTO DAS INFORMACOES ===== */

          // Alinha o texto pelo canto direito
          this.textoInfo.anchor.set(1, 0);

          // Posiciona com margem de seguranca
          this.textoInfo.x = 1050;
          this.textoInfo.y = 0;


          // ==========================================
          // BARRAS INDEPENDENTES DOS ZUMBIS
          // ==========================================

          this.barrasZumbis = new PIXI.Graphics();

          this.addChild(this.barrasZumbis);

          // ==========================================
          // CONTAINER DA LOJA
          // ==========================================

          this.lojaContainer = new PIXI.Container();

          this.addChild(this.lojaContainer);

          // Fundo escuro
          this.fundoLoja = new PIXI.Graphics();

          this.lojaContainer.addChild(
              this.fundoLoja
          );

          // Fundo e bordas dos cards
          this.graficosLoja = new PIXI.Graphics();

          this.lojaContainer.addChild(
              this.graficosLoja
          );

          // ===== FUNCAO PARA TEXTOS DA LOJA =====

          this.criarTextoLoja = (
              tamanho,
              cor,
              largura = 220
          ) => {

              const estilo = new PIXI.TextStyle({
                  fontFamily: 'Arial',
                  fontSize: tamanho,
                  fontWeight: 'bold',
                  fill: cor,
                  wordWrap: true,
                  wordWrapWidth: largura
              });

              estilo.align = 'center';

              const texto = new PIXI.Text('', estilo);

              texto.anchor.set(0.5);

              this.lojaContainer.addChild(texto);

              return texto;
          };

          // ===== TITULO DA LOJA =====

          this.tituloLoja = this.criarTextoLoja(
              30,
              0xFFFFFF,
              800
          );

          this.tituloLoja.x = 615;
          this.tituloLoja.y = 155;

          // ===== SALDO =====

          this.saldoLoja = this.criarTextoLoja(
              22,
              0xFACC15,
              600
          );

          this.saldoLoja.x = 615;
          this.saldoLoja.y = 225;

          // ===== TEXTOS DOS TRES CARDS =====

          this.cardsLoja = [];

          for (let i = 0; i < 3; i++) {

              const texto = this.criarTextoLoja(
                  19,
                  0xFFFFFF,
                  215
              );

              texto.x = 355 + i * 260;
              texto.y = 355;

              this.cardsLoja.push(texto);
          }

          // ===== INSTRUCOES =====

          this.instrucaoLoja = this.criarTextoLoja(
              19,
              0xD1D5DB,
              900
          );

          this.instrucaoLoja.x = 615;
          this.instrucaoLoja.y = 525;

          // Loja inicialmente oculta
          this.lojaContainer.visible = false;

          // ===== CONFIGURACAO DAS BARRAS =====

          this.larguraBarraZumbi = 46;
          this.alturaBarraZumbi = 7;

          // Posicao acima dos zumbis
          this.deslocamentoBarraZumbi = 43;
        arguments: {}
        lib: core
    extends:
      cgroup: ''
      'editor:myCollidingCGroups': []
    lastmod: 1794486805241
    uid: 1bqjJwgwt7pWJ3
    behaviors: []
    extendTypes: ''
    defaultText: ''
    textStyle: 2KWWMJk43hLqWJ
  - type: template
    baseClass: Text
    name: GerenciadorOndas
    depth: 0
    texture: -1
    playAnimationOnStart: false
    loopAnimation: true
    animationFPS: 30
    visible: true
    events:
      - eventKey: OnStep
        lib: core
        code: |-

          const agora = Date.now();

          const jogadores = templates.list['Jogador'] || [];
          const jogador = jogadores.find(j => templates.valid(j));

          if (!jogador || jogador.vida <= 0) {
              return;
          }

          // Apenas o gerenciador principal executa
          const gerenciadores =
              templates.list['GerenciadorOndas'] || [];

          const principal = gerenciadores.find(
              g => templates.valid(g)
          );

          if (principal !== this) {
              return;
          }


          /* ===== LOJA DE MELHORIAS ===== */

          if (this.estado === 'escolha') {

              let indice = -1;

              if (actions.Escolha1?.pressed) {
                  indice = 0;
              } else if (actions.Escolha2?.pressed) {
                  indice = 1;
              } else if (actions.Escolha3?.pressed) {
                  indice = 2;
              }

              // Permite pular a loja com a tecla 0
              if (actions.PularMelhoria?.pressed) {
                  this.opcoesMelhoria = [];
                  this.estado = 'intervalo';
                  this.proximaOndaEm =
                      agora + this.intervaloOndas;

                  console.log('Loja ignorada.');
                  return;
              }

              if (
                  indice >= 0 &&
                  indice < this.opcoesMelhoria.length
              ) {
                  const melhoria = this.opcoesMelhoria[indice];

                  // Verifica saldo disponível
                  if (jogador.moedas < melhoria.preco) {

                      console.log(
                          'MOEDAS INSUFICIENTES!',
                          'Necessário:', melhoria.preco,
                          'Disponível:', jogador.moedas
                      );

                      return;
                  }

                  // Aplica a melhoria
                  switch (melhoria.id) {

                      case 'dano':
                          jogador.dano += 5;
                          break;

                      case 'movimento':
                          jogador.velocidade += 20;
                          break;

                      case 'vida':
                          jogador.vidaMaxima += 20;
                          break;

                      case 'projetil':
                          jogador.velocidadeProjetil += 75;
                          break;
                  }

                  // Desconta as moedas somente
                  // depois de uma compra válida
                  jogador.moedas -= melhoria.preco;

                  console.log(
                      'MELHORIA COMPRADA:',
                      melhoria.nome,
                      '| Preço:', melhoria.preco,
                      '| Saldo:', jogador.moedas
                  );

                  // Fecha a loja
                  this.opcoesMelhoria = [];
                  this.estado = 'intervalo';

                  this.proximaOndaEm =
                      agora + this.intervaloOndas;
              }

              return;
          }


          /* ===== CONTAR ZUMBIS ===== */

          const zumbis = templates.list['Zumbi'] || [];

          const inimigosVivos = zumbis.filter(
              z => templates.valid(z) &&
                   !z.kill &&
                   z.vida > 0
          ).length;

          /* ===== INICIAR ONDA ===== */

          if (
              this.estado !== 'combate' &&
              agora >= this.proximaOndaEm
          ) {
              this.onda++;

              const quantidade =
                  this.inimigosPorOnda +
                  (this.onda - 1) * 2;

              this.estado = 'combate';
              this.observouInimigos = false;
              this.inicioOndaEm = agora;

              for (let i = 0; i < quantidade; i++) {

                  const lado = Math.floor(Math.random() * 4);

                  let x, y;

                  if (lado === 0) {
                      x = 32 + Math.random() * 1216;
                      y = 32;
                  } else if (lado === 1) {
                      x = 32 + Math.random() * 1216;
                      y = 688;
                  } else if (lado === 2) {
                      x = 32;
                      y = 32 + Math.random() * 656;
                  } else {
                      x = 1248;
                      y = 32 + Math.random() * 656;
                  }

                  const zumbi = templates.copy(
                      'Zumbi', x, y
                  );

                  // Escalonamento dos inimigos
                  zumbi.vidaMaxima =
                      40 + (this.onda - 1) * 10;

                  zumbi.vida = zumbi.vidaMaxima;

                  zumbi.dano =
                      10 + (this.onda - 1) * 2;

                  zumbi.velocidade = Math.min(
                      90 + (this.onda - 1) * 3,
                      180
                  );
              }

              console.log(
                  'ONDA', this.onda,
                  '| INIMIGOS:', quantidade
              );

              return;
          }

          /* ===== FINALIZAR ONDA ===== */

          if (this.estado === 'combate') {

              if (inimigosVivos > 0) {
                  this.observouInimigos = true;
              }

              const tempoMinimo =
                  agora - this.inicioOndaEm >= 300;

              if (
                  this.observouInimigos &&
                  tempoMinimo &&
                  inimigosVivos === 0
              ) {

                  console.log(
                      'ONDA', this.onda, 'CONCLUIDA!'
                  );

                  // A cada terceira onda
                  
          if (this.onda % 1 === 0) {

              // Recolhe as moedas restantes do mapa
              const moedasRestantes =
                  templates.list['Moeda'] || [];

              for (const moeda of moedasRestantes) {

                  if (
                      templates.valid(moeda) &&
                      !moeda.kill &&
                      !moeda.coletada
                  ) {
                      jogador.moedas += moeda.valor;

                      moeda.coletada = true;
                      moeda.kill = true;
                  }
              }

              // Abre a loja após recolher as moedas
              this.estado = 'escolha';
          ``

                      // Sorteia 3 melhorias sem repetição
                      const disponiveis = [
                          ...this.melhoriasDisponiveis
                      ];

                      for (let i = disponiveis.length - 1; i > 0; i--) {
                          const j = Math.floor(
                              Math.random() * (i + 1)
                          );

                          [
                              disponiveis[i],
                              disponiveis[j]
                          ] = [
                              disponiveis[j],
                              disponiveis[i]
                          ];
                      }

                      this.opcoesMelhoria =
                          disponiveis.slice(0, 3);

                      console.log(
                          'ESCOLHA UMA MELHORIA:',
                          this.opcoesMelhoria
                      );

                  } else {

                      this.estado = 'intervalo';

                      this.proximaOndaEm =
                          agora + this.intervaloOndas;
                  }
              }
          }
        arguments: {}
      - eventKey: OnCreate
        code: |-
          this.onda = 0;
          this.inimigosPorOnda = 3;
          this.intervaloOndas = 3000;

          this.estado = 'aguardando';
          this.proximaOndaEm = Date.now() + 1000;

          // Proteção contra ondas duplicadas
          this.observouInimigos = false;
          this.inicioOndaEm = 0;

          // Sistema de melhorias
          this.melhoriasDisponiveis = [
              {
                  id: 'dano',
                  nome: 'DANO +5',
                  preco: 15
              },
              {
                  id: 'movimento',
                  nome: 'VELOCIDADE +20',
                  preco: 10
              },
              {
                  id: 'vida',
                  nome: 'VIDA MAXIMA +20',
                  preco: 20
              },
              {
                  id: 'projetil',
                  nome: 'PROJETIL +75',
                  preco: 15
              }
          ];

          this.opcoesMelhoria = [];
        arguments: {}
        lib: core
    extends:
      cgroup: ''
      'editor:myCollidingCGroups': []
    lastmod: 1794423860843
    uid: j1P8f6c1cnnn97
    behaviors: []
    extendTypes: ''
    defaultText: ''
    textStyle: -1
  - type: template
    baseClass: AnimatedSprite
    name: KitMedico
    depth: 0
    texture: whJ4Nbdbzc5Pm5
    playAnimationOnStart: false
    loopAnimation: true
    animationFPS: 30
    visible: true
    events:
      - eventKey: OnStep
        lib: core
        code: |

          if (this.coletado) {
              return;
          }

          // Verifica colisão com o jogador
          const jogador = place.meet(this, 'Jogador');

          if (!jogador || !templates.valid(jogador)) {
              return;
          }

          // Não permite coleta após o Game Over
          if (jogador.vida <= 0) {
              return;
          }

          // Só coleta se o jogador precisar de cura
          if (jogador.vida >= jogador.vidaMaxima) {
              return;
          }

          // Calcula a vida recuperada
          const vidaAnterior = jogador.vida;

          jogador.vida = Math.min(
              jogador.vida + this.cura,
              jogador.vidaMaxima
          );

          // Impede coleta duplicada
          this.coletado = true;

          console.log(
              'KIT MÉDICO COLETADO!',
              'Vida anterior:', vidaAnterior,
              'Vida atual:', jogador.vida
          );

          // Remove o kit do cenário
          this.kill = true;
        arguments: {}
      - eventKey: OnCreate
        code: |

          this.cura = 20;

          // Impede que o kit seja coletado duas vezes
          this.coletado = false;

          // Kit permanece parado no chão
          this.hspeed = 0;
          this.vspeed = 0;
        arguments: {}
        lib: core
    extends:
      cgroup: ''
      'editor:myCollidingCGroups': []
    lastmod: 1794422540772
    uid: w5GfBKFnqBKKqB
    behaviors: []
    extendTypes: ''
  - type: template
    baseClass: AnimatedSprite
    name: Moeda
    depth: 0
    texture: 6d7TTqMzbC8rR5
    playAnimationOnStart: false
    loopAnimation: true
    animationFPS: 60
    visible: true
    events:
      - eventKey: OnStep
        lib: core
        code: |

          if (this.coletada) {
              return;
          }

          const jogadores = templates.list['Jogador'] || [];

          const jogador = jogadores.find(
              j => templates.valid(j) && j.vida > 0
          );

          if (!jogador) {
              return;
          }

          // Calcula a distância até o jogador
          const dx = jogador.x - this.x;
          const dy = jogador.y - this.y;
          const distancia = Math.hypot(dx, dy);

          // Ativa o ímã
          if (distancia <= this.raioAtracao) {
              this.sendoAtraida = true;
          }

          if (this.sendoAtraida && distancia > 0) {

              // Aceleração gradual
              this.velocidadeAtual = Math.min(
                  this.velocidadeAtual +
                  this.aceleracao * u.time,
                  this.velocidadeMaxima
              );

              // Direção do movimento
              this.hspeed =
                  (dx / distancia) * this.velocidadeAtual;

              this.vspeed =
                  (dy / distancia) * this.velocidadeAtual;

              // Faz a moeda deslizar
              this.move();

              // Verifica a distância após movimentar
              const distanciaFinal = Math.hypot(
                  jogador.x - this.x,
                  jogador.y - this.y
              );

              if (distanciaFinal <= this.distanciaColeta) {

                  jogador.moedas += this.valor;

                  this.coletada = true;
                  this.kill = true;

                  console.log(
                      'Moeda coletada! Total:',
                      jogador.moedas
                  );
              }
          }
        arguments: {}
      - eventKey: OnCreate
        code: |

          this.valor = 1;
          this.coletada = false;

          // Configurações do ímã
          this.raioAtracao = 180;
          this.distanciaColeta = 8;

          // Velocidade em pixels por segundo
          this.velocidadeAtual = 0;
          this.velocidadeMaxima = 220;
          this.aceleracao = 350;

          // Controle da atração
          this.sendoAtraida = false;

          this.hspeed = 0;
          this.vspeed = 0;
        arguments: {}
        lib: core
    extends:
      cgroup: circular
      'editor:myCollidingCGroups':
        - ''
    lastmod: 1794423465405
    uid: J85nHDQdmCR3kq
    behaviors: []
    extendTypes: ''
    tilingSettings:
      scrollSpeedX: 0
      scrollSpeedY: 0
      pixelPerfect: false
      isUi: false
    repeaterSettings:
      defaultCount: 3
  - type: room
    oncreate: ''
    onstep: ''
    ondraw: ''
    onleave: ''
    gridX: 64
    gridY: 64
    diagonalGrid: false
    disableGrid: false
    simulate: true
    width: 1280
