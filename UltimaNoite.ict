  - type: template
    baseClass: AnimatedSprite
    name: Jogador
    depth: 0
    texture: k9QwL7rngqPDhk
    playAnimationOnStart: false
    loopAnimation: true
    animationFPS: 30
    visible: true
    events:
      - eventKey: OnStep
        lib: core
        code: |+

          /* ===== MOVIMENTAÇÃO ===== */

          const dx = actions.MoveXesq.value +
                     actions.MoveXdir.value;

          const dy = actions.MoveYcima.value +
                     actions.MoveYbaixo.value;

          const distancia = Math.hypot(dx, dy);

          if (distancia > 0) {
              this.hspeed = (dx / distancia) * this.velocidade;
              this.vspeed = (dy / distancia) * this.velocidade;
          } else {
              this.hspeed = 0;
              this.vspeed = 0;
          }

          this.move();

          // Limites da arena
          this.x = Math.max(16, Math.min(1264, this.x));
          this.y = Math.max(16, Math.min(704, this.y));


          /* ===== MIRA COM O MOUSE ===== */

          // Calcula o ângulo até o cursor
          const angulo = u.pointDirection(
              this.x,
              this.y,
              pointer.x,
              pointer.y
          );

          // Rotaciona visualmente o jogador
          // A textura original aponta para cima
          this.angle = angulo + 90;


          /* ===== DISPARO ===== */


          if (actions.Atirar.pressed) {

              const tiro = templates.copy(
                  'Projetil',
                  this.x,
                  this.y
              );

              tiro.dano = this.dano;
              tiro.direction = angulo;
              tiro.angle = angulo;
          }

        arguments: {}
      - eventKey: OnCreate
        code: |-
          this.vida = 100;
          this.vidaMaxima = 100;
          this.velocidade = 240;
          this.dano = 20;
          this.moedas = 0;
          this.pontos = 0;
        arguments: {}
        lib: core
    extends:
      cgroup: ''
      'editor:myCollidingCGroups': []
    lastmod: 1794253899013
    uid: 489p9JKMb6NGWT
    behaviors: []
    extendTypes: ''
  - type: template
    baseClass: AnimatedSprite
    name: Zumbi
    depth: 0
    texture: 9BrRzpMzmwL4Gq
    playAnimationOnStart: false
    loopAnimation: true
    animationFPS: 30
    visible: true
    events:
      - eventKey: OnStep
        lib: core
        code: |

          const jogadores = templates.list['Jogador'];

          if (jogadores && jogadores.length > 0) {

              const jogador = jogadores[0];

              if (templates.valid(jogador)) {

                  const dx = jogador.x - this.x;
                  const dy = jogador.y - this.y;
                  const distancia = Math.hypot(dx, dy);

                  // Persegue o jogador
                  if (distancia > 20) {
                      this.hspeed =
                          (dx / distancia) * this.velocidade;

                      this.vspeed =
                          (dy / distancia) * this.velocidade;
                  } else {
                      this.hspeed = 0;
                      this.vspeed = 0;
                  }

                  // Movimenta o zumbi
                  this.move();

                  // Verifica colisão com o jogador
                  const colisao = place.meet(
                      this,
                      'Jogador'
                  );

                  if (colisao) {

                      const agora = Date.now();

                      // Limita o dano a cada 1 segundo
                      if (
                          agora - this.ultimoAtaque >=
                          this.intervaloAtaque
                      ) {

                          jogador.vida -= this.dano;

                          this.ultimoAtaque = agora;

                          console.log(
                              'Jogador atingido! Vida:',
                              jogador.vida
                          );

                          // Impede vida negativa
                          if (jogador.vida <= 0) {
                              jogador.vida = 0;

                              console.log('GAME OVER!');
                          }
                      }
                  }
              }
          }
        arguments: {}
      - eventKey: OnCreate
        code: |-
          this.vida = 40;
          this.vidaMaxima = 40;
          this.velocidade = 90;
          this.dano = 10;
          this.pontosAoMorrer = 100;

          this.hspeed = 0;
          this.vspeed = 0;

          // Controle do intervalo entre ataques
          this.ultimoAtaque = 0;
          this.intervaloAtaque = 1000;
        arguments: {}
        lib: core
    extends:
      cgroup: ''
      'editor:myCollidingCGroups': []
    lastmod: 1794252293293
    uid: Wc8qB488wMpN3Q
    behaviors: []
    extendTypes: ''
  - type: template
    baseClass: AnimatedSprite
    name: Projetil
    depth: 0
    texture: 3CnmjDpf4k3Pw3
    playAnimationOnStart: false
    loopAnimation: true
    animationFPS: 30
    visible: true
    events:
      - eventKey: OnStep
        lib: core
        code: |

          /* ===== MOVIMENTAÇÃO ===== */

          this.angle = this.direction;
          this.move();

          /* ===== COLISÃO COM ZUMBI ===== */

          const zumbi = place.meet(this, 'Zumbi');

          if (
              zumbi &&
              templates.valid(zumbi) &&
              !zumbi.kill &&
              zumbi.vida > 0
          ) {
              // Aplica dano
              zumbi.vida -= this.dano;

              console.log(
                  'Zumbi atingido! Vida:',
                  zumbi.vida
              );

              /* ===== MORTE DO ZUMBI ===== */

              if (zumbi.vida <= 0) {

                  // Bloqueia novas mortes
                  zumbi.kill = true;

                  // Adiciona pontuação ao jogador
                  const jogadores =
                      templates.list['Jogador'] || [];

                  const jogador = jogadores.find(
                      j => templates.valid(j)
                  );

                  if (jogador) {
                      jogador.pontos +=
                          zumbi.pontosAoMorrer;
                  }

                  /* ===== DROP DE KIT MÉDICO ===== */

                  // 7% de chance
                  const chance = Math.random();

                  if (chance < 0.07) {

                      templates.copy(
                          'KitMedico',
                          zumbi.x,
                          zumbi.y
                      );

                      console.log(
                          'Kit médico apareceu!'
                      );
                  }
              }

              // Remove a bala depois do impacto
              this.kill = true;

          } else if (
              this.x < -40 ||
              this.x > 1320 ||
              this.y < -40 ||
              this.y > 760
          ) {
              // Remove tiros fora da arena
              this.kill = true;
          }
        arguments: {}
      - eventKey: OnCreate
        code: |

          this.speed = 500;
          this.dano = 20;
        arguments: {}
        lib: core
    extends:
      cgroup: ''
      'editor:myCollidingCGroups': []
    lastmod: 1794422540771
    uid: bThjTDTzGtRMcm
    behaviors: []
    extendTypes: ''
