  - type: template
    baseClass: Text
    name: Hud
    depth: 0
    texture: -1
    playAnimationOnStart: false
    loopAnimation: true
    animationFPS: 30
    visible: true
    events:
      - eventKey: OnStep
        lib: core
        code: |

          // A HUD e atualizada no evento
          // No final do quadro.
        arguments: {}
      - eventKey: OnDraw
        code: |

          /* =========================================
             ULTIMA NOITE - HUD
             EVENTO: NO FINAL DO QUADRO
          ========================================= */

          // ===== BUSCAR JOGADOR =====

          const jogadores = templates.list['Jogador'] || [];

          const jogador = jogadores.find(
              j => templates.valid(j)
          );

          if (!jogador) {

              this.textoVida.text = '';
              this.textoInfo.text = '';

              this.graficosVida.clear();
              this.lojaContainer.visible = false;

              return;
          }

          // ===== BUSCAR GERENCIADOR =====

          const gerenciadores =
              templates.list['GerenciadorOndas'] || [];

          const gerenciador = gerenciadores.find(
              g => templates.valid(g)
          );

          // ===== CONTAR INIMIGOS =====

          const zumbis = templates.list['Zumbi'] || [];

          const inimigos = zumbis.filter(
              z => templates.valid(z) &&
                   !z.kill &&
                   z.vida > 0
          ).length;

          // ===== DADOS DO JOGADOR =====

          const vida = Math.max(
              0,
              Math.ceil(jogador.vida)
          );

          const vidaMaxima = Math.max(
              1,
              jogador.vidaMaxima
          );

          const percentual = Math.max(
              0,
              Math.min(
                  1,
                  vida / vidaMaxima
              )
          );

          // ===== DADOS DA ONDA =====

          const onda = gerenciador
              ? gerenciador.onda
              : 0;

          // ===== TEXTO DA VIDA =====

          this.textoVida.text =
              'VIDA: ' + vida +
              '/' + vidaMaxima;

          // ===== DESENHAR BARRA DE VIDA =====

          this.graficosVida.clear();

          // Fundo da barra
          this.graficosVida.beginFill(0x542B35);

          this.graficosVida.drawRoundedRect(
              5, 34, 250, 18, 6
          );

          this.graficosVida.endFill();

          // Vida restante
          if (percentual > 0) {

              const cor = percentual <= 0.30
                  ? 0xF59E42
                  : 0xEF5365;

              this.graficosVida.beginFill(cor);

              this.graficosVida.drawRoundedRect(
                  5,
                  34,
                  250 * percentual,
                  18,
                  6
              );

              this.graficosVida.endFill();
          }

          // ===== INFORMACOES DA PARTIDA =====

          this.textoInfo.text =
              'PONTOS: ' + jogador.pontos +
              '\nMOEDAS: ' + jogador.moedas +
              '\nONDA: ' + onda +
              '\nINIMIGOS: ' + inimigos;

          // ===== VERIFICAR LOJA =====

          const lojaAberta = Boolean(
              gerenciador &&
              gerenciador.estado === 'escolha'
          );

          this.lojaContainer.visible = lojaAberta;

          // ===== DESENHAR LOJA =====

          if (lojaAberta) {

              // Fundo escuro da loja
              this.fundoLoja.clear();

              this.fundoLoja.beginFill(
                  0x080D17,
                  0.90
              );

              this.fundoLoja.drawRect(
                  -25,
                  -25,
                  1280,
                  720
              );

              this.fundoLoja.endFill();

              // ===== TITULO =====

              this.tituloLoja.text =
                  'ONDA ' + onda +
                  ' CONCLUIDA!\nLOJA DE MELHORIAS';

              // ===== SALDO =====

              this.saldoLoja.text =
                  'SALDO: ' +
                  jogador.moedas +
                  ' MOEDAS';

              // ===== LIMPAR DESENHOS =====

              this.graficosLoja.clear();

              const opcoes =
                  gerenciador.opcoesMelhoria || [];

              // ===== CRIAR OS TRES CARDS =====

              for (let i = 0; i < 3; i++) {

                  const melhoria = opcoes[i];

                  if (!melhoria) {

                      this.cardsLoja[i].text = '';
                      continue;
                  }

                  const x = 235 + i * 260;
                  const y = 270;

                  const podeComprar =
                      jogador.moedas >= melhoria.preco;

                  // Cores do card
                  const corFundo = podeComprar
                      ? 0x293143
                      : 0x353039;

                  const corBorda = podeComprar
                      ? 0xE6BE64
                      : 0x76505A;

                  // ===== FUNDO DO CARD =====

                  this.graficosLoja.beginFill(
                      corFundo
                  );

                  this.graficosLoja.drawRoundedRect(
                      x,
                      y,
                      240,
                      180,
                      12
                  );

                  this.graficosLoja.endFill();

                  // ===== BORDA DO CARD =====

                  this.graficosLoja.lineStyle(
                      2,
                      corBorda
                  );

                  this.graficosLoja.drawRoundedRect(
                      x,
                      y,
                      240,
                      180,
                      12
                  );

                  this.graficosLoja.lineStyle(0);

                  // ===== STATUS DA COMPRA =====

                  const status = podeComprar
                      ? 'DISPONIVEL'
                      : 'SEM MOEDAS';

                  // ===== TEXTO DO CARD =====

                  this.cardsLoja[i].text =
                      '[' + (i + 1) + ']' +
                      '\n\n' +
                      melhoria.nome +
                      '\n\n' +
                      melhoria.preco + ' MOEDAS' +
                      '\n' +
                      status;
              }

              // ===== INSTRUCOES =====

              this.instrucaoLoja.text =
                  'PRESSIONE 1, 2 OU 3 PARA COMPRAR' +
                  '\nPRESSIONE 0 PARA PULAR';
          }
        arguments: {}
        lib: core
      - eventKey: OnCreate
        code: |

          /* =========================================
             ULTIMA NOITE - HUD
             EVENTO: CRIACAO
          ========================================= */

          // Remove texto padrao
          this.text = '';

          // ===== FUNCAO PARA CRIAR TEXTOS =====

          this.criarTexto = (
              tamanho,
              cor,
              alinhamento = 'left'
          ) => {

              const texto = new PIXI.Text('', {
                  fontFamily: 'Arial',
                  fontSize: tamanho,
                  fontWeight: 'bold',
                  fill: cor,
                  align: alinhamento
              });

              this.addChild(texto);

              return texto;
          };

          // ===== BARRA DE VIDA DO JOGADOR =====

          this.graficosVida = new PIXI.Graphics();

          this.addChild(this.graficosVida);

          this.textoVida = this.criarTexto(
              22,
              0xFFFFFF
          );

          this.textoVida.x = 5;
          this.textoVida.y = 0;

          // ===== PONTOS, MOEDAS E ONDAS =====

          this.textoInfo = this.criarTexto(
              20,
              0xFFFFFF,
              'right'
          );

          /* ===== POSICIONAMENTO DA HUD DIREITA ===== */

          // Ancora o texto pelo canto superior direito
          this.textoInfo.anchor.set(1, 0);

          // Coordenada relativa ao Template HUD
          this.textoInfo.x = 1050;
          this.textoInfo.y = 0;



          // ===== CONTAINER DA LOJA =====

          this.lojaContainer = new PIXI.Container();

          this.addChild(this.lojaContainer);

          // Fundo escuro
          this.fundoLoja = new PIXI.Graphics();

          this.lojaContainer.addChild(
              this.fundoLoja
          );

          // Fundo e bordas dos cards
          this.graficosLoja = new PIXI.Graphics();

          this.lojaContainer.addChild(
              this.graficosLoja
          );

          // ===== FUNCAO PARA TEXTOS DA LOJA =====

          this.criarTextoLoja = (
              tamanho,
              cor,
              largura = 220
          ) => {

              const texto = new PIXI.Text('', {
                  fontFamily: 'Arial',
                  fontSize: tamanho,
                  fontWeight: 'bold',
                  fill: cor,
                  align: 'center',
                  wordWrap: true,
                  wordWrapWidth: largura
              });

              texto.anchor.set(0.5);

              this.lojaContainer.addChild(texto);

              return texto;
          };

          // ===== TITULO DA LOJA =====

          this.tituloLoja = this.criarTextoLoja(
              30,
              0xFFFFFF,
              800
          );

          this.tituloLoja.x = 615;
          this.tituloLoja.y = 155;

          // ===== SALDO DE MOEDAS =====

          this.saldoLoja = this.criarTextoLoja(
              22,
              0xFACC15,
              600
          );

          this.saldoLoja.x = 615;
          this.saldoLoja.y = 225;

          // ===== TRES CARDS =====

          this.cardsLoja = [];

          for (let i = 0; i < 3; i++) {

              const texto = this.criarTextoLoja(
                  19,
                  0xFFFFFF,
                  215
              );

              texto.x = 355 + i * 260;
              texto.y = 355;

              this.cardsLoja.push(texto);
          }

          // ===== INSTRUCOES DA LOJA =====

          this.instrucaoLoja = this.criarTextoLoja(
              19,
              0xD1D5DB,
              900
          );

          this.instrucaoLoja.x = 615;
          this.instrucaoLoja.y = 525;

          // Loja inicialmente escondida
          this.lojaContainer.visible = false;
        arguments: {}
        lib: core
    extends:
      cgroup: ''
      'editor:myCollidingCGroups': []
