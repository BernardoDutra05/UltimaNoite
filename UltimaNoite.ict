  - type: template
    baseClass: Text
    name: Hud
    depth: 0
    texture: -1
    playAnimationOnStart: false
    loopAnimation: true
    animationFPS: 30
    visible: true
    events:
      - eventKey: OnStep
        lib: core
        code: |-
          VIDA: 100/100
          PONTOS: 0
          MOEDAS: 0
        arguments: {}
      - eventKey: OnDraw
        code: |

          const jogadores = templates.list['Jogador'];

          const gerenciadores =
              templates.list['GerenciadorOndas'];

          if (jogadores && jogadores.length > 0) {

              const jogador = jogadores[0];

              if (templates.valid(jogador)) {

                  const vida = Math.max(
                      0,
                      Math.ceil(jogador.vida)
                  );

                  let onda = 0;
                  let inimigos = 0;

                  if (gerenciadores &&
                      gerenciadores.length > 0) {

                      const gerenciador = gerenciadores[0];

                      if (templates.valid(gerenciador)) {
                          onda = gerenciador.onda;
                      }
                  }

                  const zumbis = templates.list['Zumbi'] || [];

                  inimigos = zumbis.filter(
                      z => templates.valid(z) && z.vida > 0
                  ).length;

                  
          this.text =
              'VIDA: ' + vida +
              '/' + jogador.vidaMaxima +
              '\nDANO: ' + jogador.dano +
              '\nPONTOS: ' + jogador.pontos +
              '\nMOEDAS: ' + jogador.moedas +
              '\nONDA: ' + onda +
              '\nINIMIGOS: ' + inimigos;

              }
          }
        arguments: {}
        lib: core
    extends:
      cgroup: ''
      'editor:myCollidingCGroups': []
    lastmod: 1794253899007
    uid: 1bqjJwgwt7pWJ3
    behaviors: []
    extendTypes: ''
    defaultText: ''
    textStyle: 2KWWMJk43hLqWJ
  - type: template
    baseClass: Text
    name: GerenciadorOndas
    depth: 0
    texture: -1
    playAnimationOnStart: false
    loopAnimation: true
    animationFPS: 30
    visible: true
    events:
      - eventKey: OnStep
        lib: core
        code: |

          const agora = Date.now();

          const jogadores = templates.list['Jogador'] || [];
          const jogador = jogadores.find(j => templates.valid(j));

          if (!jogador || jogador.vida <= 0) {
              return;
          }

          // Garante que somente um gerenciador execute
          const gerenciadores =
              templates.list['GerenciadorOndas'] || [];

          const gerenciadorPrincipal =
              gerenciadores.find(g => templates.valid(g));

          if (gerenciadorPrincipal !== this) {
              return;
          }

          const zumbis = templates.list['Zumbi'] || [];

          const inimigosVivos = zumbis.filter(
              z => templates.valid(z) && z.vida > 0
          ).length;

          /* ===== INICIAR ONDA ===== */

          if (
              this.estado !== 'combate' &&
              agora >= this.proximaOndaEm
          ) {
              this.onda++;

              const quantidade =
                  this.inimigosPorOnda +
                  (this.onda - 1) * 2;

              // Bloqueia novo início imediatamente
              this.estado = 'combate';
              this.observouInimigos = false;
              this.inicioOndaEm = agora;

              for (let i = 0; i < quantidade; i++) {

                  const lado = Math.floor(Math.random() * 4);
                  let x, y;

                  if (lado === 0) {
                      x = 32 + Math.random() * 1216;
                      y = 32;
                  } else if (lado === 1) {
                      x = 32 + Math.random() * 1216;
                      y = 688;
                  } else if (lado === 2) {
                      x = 32;
                      y = 32 + Math.random() * 656;
                  } else {
                      x = 1248;
                      y = 32 + Math.random() * 656;
                  }

                  const zumbi = templates.copy('Zumbi', x, y);

                  zumbi.vidaMaxima =
                      40 + (this.onda - 1) * 10;

                  zumbi.vida = zumbi.vidaMaxima;

                  zumbi.dano =
                      10 + (this.onda - 1) * 2;

                  zumbi.velocidade = Math.min(
                      90 + (this.onda - 1) * 3,
                      180
                  );
              }

              console.log(
                  'INÍCIO DA ONDA:',
                  this.onda,
                  '| Zumbis criados:',
                  quantidade
              );

              return;
          }

          /* ===== ACOMPANHAR COMBATE ===== */

          if (this.estado === 'combate') {

              // Confirma que os zumbis apareceram
              if (inimigosVivos > 0) {
                  this.observouInimigos = true;
              }

              // Aguarda pelo menos 300ms após criar a onda
              const tempoMinimo =
                  agora - this.inicioOndaEm >= 300;

              // Só conclui após observar inimigos vivos
              if (
                  this.observouInimigos &&
                  tempoMinimo &&
                  inimigosVivos === 0
              ) {
                  this.estado = 'intervalo';

                  this.proximaOndaEm =
                      agora + this.intervaloOndas;

                  // Melhorias do jogador
                  
           // Aumenta apenas a capacidade máxima de vida
          jogador.vidaMaxima += 10;

          // Aumenta o dano do jogador
          jogador.dano += 5;

          // NÃO recupera vida automaticamente
          console.log(
              'Vida atual:', jogador.vida,
              '| Vida máxima:', jogador.vidaMaxima,
              '| Dano:', jogador.dano
          );
                  jogador.dano += 5;

                  console.log(
                      'ONDA CONCLUÍDA:',
                      this.onda,
                      '| Vida máxima:',
                      jogador.vidaMaxima,
                      '| Dano:',
                      jogador.dano
                  );
              }
          }
        arguments: {}
      - eventKey: OnCreate
        code: |

          this.onda = 0;
          this.inimigosPorOnda = 3;
          this.intervaloOndas = 3000;

          this.estado = 'aguardando';
          this.proximaOndaEm = Date.now() + 1000;

          // Proteções contra ondas duplicadas
          this.observouInimigos = false;
          this.inicioOndaEm = 0;
        arguments: {}
        lib: core
    extends:
      cgroup: ''
      'editor:myCollidingCGroups': []
