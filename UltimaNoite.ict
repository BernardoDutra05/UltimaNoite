  - type: template
    baseClass: Text
    name: TelaMenu
    depth: 0
    texture: -1
    playAnimationOnStart: false
    loopAnimation: true
    animationFPS: 30
    visible: true
    events:
      - eventKey: OnCreate
        code: |

          /* =====================================
             ULTIMA NOITE - MENU PRINCIPAL
             EVENTO: CRIACAO
          ===================================== */

          this.text = '';

          // Grupo principal
          this.painel = new PIXI.Container();
          this.addChild(this.painel);

          // Funcao de texto
          this.criarTexto = (conteudo, tamanho, cor, x, y) => {
              const txt = new PIXI.Text(conteudo, {
                  fontFamily: 'Arial',
                  fontSize: tamanho,
                  fontWeight: 'bold',
                  fill: cor,
                  align: 'center'
              });

              txt.anchor.set(0.5);
              txt.x = x;
              txt.y = y;

              this.painel.addChild(txt);
              return txt;
          };

          // Funcao de botao
          this.criarBotao = (nome, x, y, largura, acao) => {
              const botao = new PIXI.Container();

              botao.x = x;
              botao.y = y;

              const fundo = new PIXI.Graphics();
              fundo.beginFill(0x293548);
              fundo.lineStyle(2, 0x536985);
              fundo.drawRoundedRect(
                  0, 0, largura, 58, 10
              );
              fundo.endFill();

              botao.addChild(fundo);

              const texto = new PIXI.Text(nome, {
                  fontFamily: 'Arial',
                  fontSize: 22,
                  fontWeight: 'bold',
                  fill: 0xFFFFFF
              });

              texto.anchor.set(0.5);
              texto.x = largura / 2;
              texto.y = 29;

              botao.addChild(texto);

              
              botao.eventMode = 'static';
              botao.cursor = 'pointer';


              botao.hitArea = new PIXI.Rectangle(
                  0, 0, largura, 58
              );

              botao.on('pointertap', acao);

              this.painel.addChild(botao);
              return botao;
          };

          // ===== TITULO =====

          this.titulo = this.criarTexto(
              'ULTIMA NOITE',
              58,
              0xFFFFFF,
              640, 160
          );

          this.subtitulo = this.criarTexto(
              'SOBREVIVA A NOITE',
              20,
              0xE9BD6E,
              640, 215
          );

          // ===== TEXTOS DAS PAGINAS =====

          this.conteudo = this.criarTexto(
              '',
              22,
              0xFFFFFF,
              640, 335
          );

          this.conteudo.style.wordWrap = true;
          this.conteudo.style.wordWrapWidth = 850;

          // ===== BOTOES =====


          this.btnJogar = this.criarBotao(
              'JOGAR',
              490, 290, 300,
              () => {
                  console.log('BOTAO JOGAR CLICADO');
                  console.log(
                      'Room antes:',
                      rooms.current
                  );

                  try {
                      rooms.switch('rm_jogo');

                      console.log(
                          'Troca solicitada para rm_jogo'
                      );
                  } catch (erro) {
                      console.error(
                          'ERRO AO TROCAR ROOM:',
                          erro
                      );
                  }
              }
          );


          this.btnComo = this.criarBotao(
              'COMO JOGAR',
              490, 365, 300,
              () => this.mostrarPagina('ajuda')
          );

          this.btnCreditos = this.criarBotao(
              'CREDITOS',
              490, 440, 300,
              () => this.mostrarPagina('creditos')
          );

          this.btnVoltar = this.criarBotao(
              'VOLTAR',
              490, 520, 300,
              () => this.mostrarPagina('inicio')
          );

          // ===== NAVEGACAO =====

          this.mostrarPagina = (pagina) => {
              const inicio = pagina === 'inicio';

              this.btnJogar.visible = inicio;
              this.btnComo.visible = inicio;
              this.btnCreditos.visible = inicio;
              this.btnVoltar.visible = !inicio;

              this.conteudo.visible = !inicio;

              if (pagina === 'ajuda') {
                  this.conteudo.text =
                      'COMO JOGAR\n\n' +
                      'WASD OU SETAS - MOVIMENTAR\n' +
                      'MOUSE - MIRAR\n' +
                      'CLIQUE ESQUERDO - ATIRAR\n' +
                      '1, 2 OU 3 - COMPRAR MELHORIA\n' +
                      '0 - PULAR A LOJA\n\n' +
                      'ELIMINE ZUMBIS, COLETE MOEDAS\n' +
                      'E KITS MEDICOS PARA SOBREVIVER.';
              }

              if (pagina === 'creditos') {
                  this.conteudo.text =
                      'CREDITOS\n\n' +
                      'ULTIMA NOITE - 2026\n\n' +
                      'DESENVOLVIMENTO:\n' +
                      'Bernardo Dutra Aperibense Ottoni' +
                      'Bruno Oliveira de Souza' +
                      'Nicolas Reis Xavier Silva' +
                      'Alceu Vasconcellos Botelho dos Reis' +
                      'DESENVOLVIDO COM CT.JS 5.3.1';
              }
          };

          this.mostrarPagina('inicio');
        arguments: {}
        lib: core
    extends:
      cgroup: ''
      'editor:myCollidingCGroups': []
