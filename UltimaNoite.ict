  - name: Escolha3
    methods:
      - code: keyboard.Digit3
      - code: keyboard.Numpad3
  - name: PularMelhoria
    methods:
      - code: keyboard.Digit0
      - code: keyboard.Numpad0
  - name: Pausar
    methods:
      - code: keyboard.KeyP
      - code: keyboard.Escape
