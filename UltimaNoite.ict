  - type: template
    baseClass: AnimatedSprite
    name: Jogador
    depth: 0
    texture: G365f6kHR8KwP8
    playAnimationOnStart: false
    loopAnimation: true
    animationFPS: 30
    visible: true
    events:
      - eventKey: OnStep
        lib: core
        code: |

          /* ==========================================
             ULTIMA NOITE - JOGADOR
             EVENTO: NO INICIO DO QUADRO

             MOVIMENTACAO + MIRA + TIRO + ANIMACAO
          ========================================== */

          // ===== VERIFICAR SE ESTA VIVO =====

          if (this.vida <= 0) {
              this.hspeed = 0;
              this.vspeed = 0;

              if (this.animando) {
                  this.gotoAndStop(0);
                  this.animando = false;
              }

              return;
          }


          // ==========================================
          // 1. MOVIMENTACAO WASD E SETAS
          // ==========================================

          const dx =
              actions.MoveXesq.value +
              actions.MoveXdir.value;

          const dy =
              actions.MoveYcima.value +
              actions.MoveYbaixo.value;

          // Normaliza o movimento diagonal
          const distancia = Math.hypot(dx, dy);

          if (distancia > 0) {

              this.hspeed =
                  (dx / distancia) * this.velocidade;

              this.vspeed =
                  (dy / distancia) * this.velocidade;

          } else {

              this.hspeed = 0;
              this.vspeed = 0;
          }

          // Aplica o movimento
          this.move();


          // ==========================================
          // 2. LIMITES DA ARENA
          // ==========================================

          // Impede que o jogador saia da arena
          this.x = Math.max(
              26,
              Math.min(1254, this.x)
          );

          this.y = Math.max(
              26,
              Math.min(694, this.y)
          );


          // ==========================================
          // 3. MIRA COM O MOUSE
          // ==========================================

          // Calcula a direcao entre o jogador
          // e a posicao atual do cursor

          const angulo = u.pointDirection(
              this.x,
              this.y,
              pointer.x,
              pointer.y
          );

          // O soldado aponta originalmente para cima.
          // O ajuste de 90 graus compensa isso.

          this.angle = angulo + 90;


          // ==========================================
          // 4. SISTEMA DE DISPARO
          // ==========================================

          if (actions.Atirar.pressed) {

              // Cria o projetil na posicao do jogador
              const tiro = templates.copy(
                  'Projetil',
                  this.x,
                  this.y
              );

              // Usa o dano atualizado pelas melhorias
              tiro.dano = this.dano;

              // Usa a velocidade atual do projetil
              tiro.speed = this.velocidadeProjetil;

              // Direcao fisica do disparo
              tiro.direction = angulo;

              // Rotacao visual do projetil
              tiro.angle = angulo;
          }


          // ==========================================
          // 5. ANIMACAO DE CAMINHADA
          // ==========================================

          // Verifica se o jogador esta se movimentando
          const andando = Math.hypot(
              this.hspeed,
              this.vspeed
          ) > 1;

          if (andando) {

              // Inicia a animacao uma unica vez
              if (!this.animando) {

                  this.gotoAndPlay(0);

                  this.animando = true;
              }

          } else {

              // Quando para, volta ao primeiro quadro
              if (this.animando) {

                  this.gotoAndStop(0);

                  this.animando = false;
              }
          }
        arguments: {}
      - eventKey: OnCreate
        code: |

          /* ==========================================
             ULTIMA NOITE - JOGADOR
             EVENTO: CRIACAO
          ========================================== */

          // ===== ATRIBUTOS DO JOGADOR =====

          // Vida
          this.vida = 100;
          this.vidaMaxima = 100;

          // Movimentacao
          this.velocidade = 240;

          // Combate
          this.dano = 20;
          this.velocidadeProjetil = 500;

          // Recursos e pontuacao
          this.moedas = 0;
          this.pontos = 0;

          // Estado do personagem
          this.gameOverRegistrado = false;

          // ===== MOVIMENTO INICIAL =====

          this.hspeed = 0;
          this.vspeed = 0;

          // ===== VISUAL DO SOLDADO =====

          // Reduz a spritesheet para o tamanho do jogo
          this.scale.set(0.09);

          // ===== ANIMACAO =====

          // Velocidade da animacao
          this.animationSpeed = 0.12;

          // Repeticao da caminhada
          this.loop = true;

          // Inicia no primeiro quadro, parado
          this.gotoAndStop(0);

          // Controle interno da animacao
          this.animando = false;

          // ===== MIRA =====

          // Soldado originalmente aponta para cima
          this.angle = 0;

          console.log(
              'Jogador criado!',
              'Vida:', this.vida,
              'Dano:', this.dano,
              'Velocidade:', this.velocidade
          );
        arguments: {}
        lib: core
    extends:
      cgroup: ''
      'editor:myCollidingCGroups': []
    lastmod: 1794485924217
